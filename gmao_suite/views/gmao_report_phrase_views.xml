<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gmao_report_phrase_tree" model="ir.ui.view">
        <field name="name">gmao.report.phrase.tree</field>
        <field name="model">gmao.report.phrase</field>
        <field name="arch" type="xml">
            <tree string="Phrases-types rapport" editable="bottom">
                <field name="category"/>
                <field name="code"/>
                <field name="name"/>
                <field name="text"/>
            </tree>
        </field>
    </record>

    <record id="view_gmao_report_phrase_search" model="ir.ui.view">
        <field name="name">gmao.report.phrase.search</field>
        <field name="model">gmao.report.phrase</field>
        <field name="arch" type="xml">
            <search string="Phrases-types">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Catégorie" name="group_by_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gmao_report_phrase" model="ir.actions.act_window">
        <field name="name">Phrases-types rapport</field>
        <field name="res_model">gmao.report.phrase</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_gmao_report_phrase_search"/>
        <field name="context">{'search_default_group_by_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créer une phrase-type</p>
            <p>Symptômes, causes, travaux et recommandations réutilisables dans
               le rapport d'intervention (gain de temps de saisie).</p>
        </field>
    </record>
</odoo>
