<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vue formulaire pour maintenance.request -->
        <record id="view_maintenance_request_form" model="ir.ui.view">
            <field name="name">maintenance.request.form</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <form string="Demande de maintenance">
                    <header>
                        <button name="action_validate" string="Valider" type="object" states="new" groups="gmao_suite.group_request_user,gmao_suite.group_request_admin" class="oe_highlight"/>
                        <button name="action_start" string="Démarrer" type="object" states="to_validate" groups="gmao_suite.group_request_user,gmao_suite.group_request_admin" class="oe_highlight"/>
                        <button name="action_repair" string="Marquer comme réparé" type="object" states="in_progress" groups="gmao_suite.group_request_user,gmao_suite.group_request_admin" class="oe_highlight"/>
                        <button name="action_done" string="Terminer" type="object" states="repaired" groups="gmao_suite.group_request_user,gmao_suite.group_request_admin" class="oe_highlight"/>
                        <button name="action_cancel" string="Annuler" type="object" states="new,to_validate,in_progress,repaired" groups="gmao_suite.group_request_user,gmao_suite.group_request_admin"/>
                        <button name="action_reset_to_draft" string="Réinitialiser" type="object" states="cancel" groups="gmao_suite.group_gmao_admin"/>
                        <button name="action_auto_assign_team" string="Auto-assigner l'équipe" type="object"
                                groups="gmao_suite.group_request_user,gmao_suite.group_request_admin"
                                attrs="{'invisible': [('state', 'in', ('done', 'cancel'))]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,to_validate,in_progress,repaired,done"/>
						
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-clock-o" name="get_current_duration" type="object">
                                <field name="duration" widget="statinfo" string="Durée"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="request_number"/>
                                <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="equipment_id" options="{'no_create': True}"/>
                                <field name="category_id" readonly="1"/>
                                <field name="site_id" readonly="1"/>
                                <field name="maintenance_type" widget="radio"/>
                                <field name="priority" widget="priority"/>
                                <field name="system"/>
                            </group>
                            <group>
                                <field name="request_date"/>
                                <field name="schedule_date"/>
                                <field name="start_date" readonly="1"/>
                                <field name="close_date" readonly="1"/>
                                <field name="technician_id" options="{'no_create': True}"/>
                                <field name="team_id" options="{'no_create': True}"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" placeholder="Décrivez le problème ou la tâche de maintenance..."/>
                                <field name="observations" placeholder="Observations supplémentaires..."/>
                            </page>
                            <page string="Rapport d'intervention" name="intervention_report">
                                <field name="maintenance_type" invisible="1"/>
                                <group>
                                    <group string="Diagnostic">
                                        <field name="failure_code_id"
                                               domain="[('applies_to', 'in', ('both', maintenance_type))]"
                                               options="{'no_quick_create': True}"/>
                                        <field name="failure_severity"
                                               attrs="{'invisible': [('maintenance_type', '=', 'preventive')]}"/>
                                        <field name="report_complete"/>
                                    </group>
                                </group>
                                <separator string="Symptôme constaté"/>
                                <field name="symptom_phrase_id" options="{'quick_create': True, 'no_open': True}"
                                       context="{'default_category': 'symptom'}"
                                       placeholder="Insérer depuis la liste (ou taper pour créer)..."/>
                                <field name="symptom" placeholder="Ce qui a été observé (bruit, fuite, arrêt, message d'erreur...)"/>
                                <separator string="Cause racine"/>
                                <field name="cause_phrase_id" options="{'quick_create': True, 'no_open': True}"
                                       context="{'default_category': 'cause'}"
                                       placeholder="Insérer depuis la liste (ou taper pour créer)..."/>
                                <field name="failure_cause" placeholder="Origine identifiée de la panne / raison de l'intervention"/>
                                <separator string="Travaux réalisés"/>
                                <field name="work_phrase_id" options="{'quick_create': True, 'no_open': True}"
                                       context="{'default_category': 'work'}"
                                       placeholder="Insérer depuis la liste (ou taper pour créer)..."/>
                                <field name="work_performed" placeholder="Actions effectuées, pièces remplacées, réglages..."/>
                                <separator string="Recommandation / suivi"/>
                                <field name="reco_phrase_id" options="{'quick_create': True, 'no_open': True}"
                                       context="{'default_category': 'recommendation'}"
                                       placeholder="Insérer depuis la liste (ou taper pour créer)..."/>
                                <field name="recommendation" placeholder="Préconisations, suivi à prévoir, pièces à surveiller..."/>
                                <div class="text-muted">
                                    Le rapport (code, cause racine, travaux) est obligatoire avant de
                                    terminer la demande. En préventif sans anomalie : code « PREV-RAS ».
                                </div>
                            </page>
                            <page string="Pièces et Coûts">
                                <!-- Table pleine largeur (façon lignes de facture) -->
                                <field name="currency_id" invisible="1"/>
                                <field name="parts_used_ids" nolabel="1">
                                    <tree editable="bottom" decoration-muted="state == 'cancelled'">
                                        <field name="product_id"/>
                                        <field name="part_nature"/>
                                        <field name="quantity"/>
                                        <field name="unit_cost"/>
                                        <field name="total_cost" sum="Coût total"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                                <!-- Bloc totaux décalé à droite (pattern Odoo oe_subtotal_footer) -->
                                <group class="oe_subtotal_footer" name="couts">
                                    <field name="hourly_rate"/>
                                    <field name="total_parts_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="labor_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"/>
                                    <field name="devis" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </page>
                            <page string="Contrat et KPI">
                                <group>
                                    <group string="Contrat">
                                        <field name="contract_id" options="{'no_create': True}"/>
                                        <field name="is_overdue"/>
                                    </group>
                                    <group string="Indicateurs (KPI)">
                                        <field name="duration" widget="float_time"/>
                                        <field name="downtime" widget="float_time"/>
                                        <field name="mttr"/>
                                        <field name="mtbf"/>
                                    </group>
                                </group>
                            </page>
                            <!--
                                Fix #3 : l'onglet "Historique des etats" est retire.
                                L'historique des transitions de state est desormais
                                affiche directement dans le chatter en bas du formulaire
                                grace au tracking=True sur le field 'state' (mail.thread).
                            -->
                            <page string="Documents">
                                <field name="document_ids" widget="many2many_binary_preview"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vue liste (tree) -->
        <record id="view_maintenance_request_tree" model="ir.ui.view">
            <field name="name">maintenance.request.tree</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <tree string="Demandes de maintenance" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state in ('repaired','done')" decoration-danger="state == 'cancel'" decoration-muted="state == 'to_validate'">
                    <field name="name"/>
                    <field name="request_number"/>
                    <field name="equipment_id"/>
                    <field name="user_id"/>
                    <field name="request_date"/>
                    <field name="schedule_date"/>
                    <field name="state"/>
                    <field name="priority" widget="priority"/>
                    <field name="maintenance_type"/>
                    <field name="system"/>
                    <field name="duration" sum="Total Duration"/>
                    <field name="total_cost" sum="Total Cost"/>
                </tree>
            </field>
        </record>

        <!-- Vue de recherche -->
        <record id="view_maintenance_request_search" model="ir.ui.view">
            <field name="name">maintenance.request.search</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <search string="Recherche de demandes de maintenance">
                    <field name="name"/>
                    <field name="request_number"/>
                    <field name="equipment_id"/>
                    <field name="user_id"/>
                    <field name="technician_id"/>
                    <field name="team_id"/>
                    <field name="system"/>
                    <field name="contract_id"/>
                    <field name="priority"/>
                    <field name="maintenance_type"/>
                    <field name="state"/>
                    <field name="site_id"/>
                    <field name="category_id"/>
                    <separator/>
                    <!-- V4 : filtres operationnels predefinis -->
                    <filter string="En retard" name="overdue"
                            domain="[('is_overdue', '=', True)]"
                            help="Demandes dont la date planifiee est passee et qui ne sont pas cloturees"/>
                    <filter string="Aujourd'hui" name="today"
                            domain="[('schedule_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                     ('schedule_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Cette semaine" name="this_week"
                            domain="[('schedule_date', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                                     ('schedule_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter string="Mes demandes" name="my_requests" domain="[('user_id', '=', uid)]"/>
                    <filter string="Mes interventions" name="my_assignments"
                            domain="[('technician_id.user_id', '=', uid)]"
                            help="Demandes ou je suis le technicien assigne"/>
                    <separator/>
                    <filter string="Nouvelles" name="new_state" domain="[('state', '=', 'new')]"/>
                    <filter string="À valider" name="to_validate" domain="[('state', '=', 'to_validate')]"/>
                    <filter string="En cours" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Terminees" name="done_state" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter string="Preventive" name="preventive" domain="[('maintenance_type', '=', 'preventive')]"/>
                    <filter string="Corrective" name="corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                    <separator/>
                    <filter string="À planifier" name="to_schedule" domain="[('schedule_date', '=', False), ('state', 'not in', ['done', 'cancel'])]"/>
                    <filter string="Avec contrat" name="with_contract" domain="[('contract_id', '!=', False)]"/>
                    <filter string="Archivé" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="État" name="groupby_state" context="{'group_by': 'state'}"/>
                        <filter string="Équipement" name="groupby_equipment" context="{'group_by': 'equipment_id'}"/>
                        <filter string="Type de maintenance" name="groupby_type" context="{'group_by': 'maintenance_type'}"/>
                        <filter string="Système" name="groupby_system" context="{'group_by': 'system'}"/>
                        <filter string="Technicien" name="groupby_technician" context="{'group_by': 'technician_id'}"/>
                        <filter string="Site" name="groupby_site" context="{'group_by': 'site_id'}"/>
                        <filter string="Catégorie" name="groupby_category" context="{'group_by': 'category_id'}"/>
                        <filter string="Mois de demande" name="groupby_month" context="{'group_by': 'request_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vue graphique -->
        <record id="view_maintenance_request_graph" model="ir.ui.view">
            <field name="name">maintenance.request.graph</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <graph string="Analyse des demandes de maintenance">
                    <!-- Dimensions disponibles pour l'analyse -->
                    <field name="state"/>
                    <field name="maintenance_type"/>
                    <field name="system"/>
                    <field name="equipment_id"/>
                    <field name="category_id"/>
                    <field name="site_id"/>
                    <field name="technician_id"/>
                    <field name="priority"/>
                    <!-- Mesures disponibles pour l'analyse -->
                    <field name="duration" type="measure"/>
                    <field name="total_cost" type="measure"/>
                    <field name="downtime" type="measure"/>
                    <field name="mttr" type="measure"/>
                    <field name="mtbf" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Vue pivot -->
        <record id="view_maintenance_request_pivot" model="ir.ui.view">
            <field name="name">maintenance.request.pivot</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <pivot string="Analyse des demandes de maintenance">
                    <field name="state" type="row"/>
                    <field name="maintenance_type" type="col"/>
                    <field name="system" type="col"/>
                    <field name="equipment_id" type="col"/>
                    <field name="category_id" type="col"/>
                    <field name="site_id" type="col"/>
                    <field name="technician_id" type="col"/>
                    <field name="priority" type="col"/>
                    <field name="duration" type="measure"/>
                    <field name="total_cost" type="measure"/>
                    <field name="downtime" type="measure"/>
                    <field name="mttr" type="measure"/>
                    <field name="mtbf" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Vue Kanban -->
        <record id="view_maintenance_request_kanban" model="ir.ui.view">
            <field name="name">maintenance.request.kanban</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="user_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <field name="maintenance_type"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                                        </div>
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="equipment_id"/>
                                        <field name="user_id"/>
                                        <field name="maintenance_type"/>
                                        <field name="system"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="state" widget="statusbar"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="duration" widget="float_time"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action pour la vue des demandes de maintenance -->
        <record id="action_maintenance_request" model="ir.actions.act_window">
            <field name="name">Demandes de maintenance</field>
            <field name="res_model">gmao.request</field>
            <field name="view_mode">tree,form,kanban,graph,pivot</field>
            <field name="search_view_id" ref="view_maintenance_request_search"/>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre première demande de maintenance
                </p>
            </field>
        </record>

        <!-- Phase D : Vue Calendar (planning interventions sur schedule_date) -->
        <record id="view_maintenance_request_calendar" model="ir.ui.view">
            <field name="name">maintenance.request.calendar</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <calendar string="Planning des interventions"
                          date_start="schedule_date"
                          date_stop="close_date"
                          color="technician_id"
                          mode="month">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="technician_id"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- Phase D : Vue Activity (Odoo 13 activity grid) -->
        <record id="view_maintenance_request_activity" model="ir.ui.view">
            <field name="name">maintenance.request.activity</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <activity string="Activites des interventions">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="technician_id"/>
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <field name="equipment_id" display="full"/>
                            </div>
                            <div>
                                <field name="technician_id"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <!-- Mise a jour action principale pour inclure les nouvelles vues -->
        <record id="action_maintenance_request" model="ir.actions.act_window">
            <field name="view_mode">tree,kanban,calendar,activity,form,graph,pivot</field>
        </record>

        <!-- Planning : page de visualisation dediee (calendrier + liste + filtres/tri).
             La vue calendar s'ouvre en premier ; l'export PDF reste dispo via le
             bouton "Imprimer planning" du formulaire equipe. -->
        <record id="action_maintenance_planning" model="ir.actions.act_window">
            <field name="name">Planning des interventions</field>
            <field name="res_model">gmao.request</field>
            <field name="view_mode">calendar,tree,form</field>
            <field name="search_view_id" ref="view_maintenance_request_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucune intervention planifiee sur la periode
                </p>
            </field>
        </record>

        <!-- P1bis (option) : evolution du cout de maintenance dans le temps,
             une ligne par equipement. Base sur gmao.request (request_date +
             total_cost), seul porteur de l'axe temps. Alimente la decision
             de remplacement (cf. action_equipment_replacement). -->
        <record id="view_request_cost_timeline_graph" model="ir.ui.view">
            <field name="name">gmao.request.cost.timeline.graph</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <graph string="Cout de maintenance dans le temps" type="line">
                    <field name="request_date" interval="month"/>
                    <field name="equipment_id"/>
                    <field name="total_cost" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_request_cost_timeline_pivot" model="ir.ui.view">
            <field name="name">gmao.request.cost.timeline.pivot</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <pivot string="Cout de maintenance dans le temps">
                    <field name="equipment_id" type="row"/>
                    <field name="request_date" interval="month" type="col"/>
                    <field name="total_cost" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- Vue liste du rapport cout (manquait : seulement graph/pivot avant,
             d'ou 'pas de liste / impossible d'imprimer en PDF'). Le PDF 'Bon
             d'intervention' est binde sur gmao.request -> menu Imprimer dispo. -->
        <record id="view_request_cost_timeline_tree" model="ir.ui.view">
            <field name="name">gmao.request.cost.timeline.tree</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <tree string="Coût de maintenance" create="false"
                      decoration-success="state=='done'" decoration-warning="maintenance_type=='corrective'">
                    <field name="request_date"/>
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="site_id"/>
                    <field name="maintenance_type"/>
                    <field name="state"/>
                    <field name="downtime" sum="Temps d'arrêt (h)"/>
                    <field name="total_cost" sum="Coût total"/>
                </tree>
            </field>
        </record>

        <record id="action_request_cost_timeline" model="ir.actions.act_window">
            <field name="name">Cout maintenance dans le temps</field>
            <field name="res_model">gmao.request</field>
            <field name="view_mode">tree,graph,pivot,form</field>
            <!-- view_ids explicite : plusieurs vues graph/pivot existent sur
                 gmao.request, on fixe celles du rapport cout. -->
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'sequence': 1, 'view_mode': 'tree', 'view_id': ref('view_request_cost_timeline_tree')}),
                (0, 0, {'sequence': 2, 'view_mode': 'graph', 'view_id': ref('view_request_cost_timeline_graph')}),
                (0, 0, {'sequence': 3, 'view_mode': 'pivot', 'view_id': ref('view_request_cost_timeline_pivot')})]"/>
            <field name="search_view_id" ref="view_maintenance_request_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucune intervention sur la periode
                </p>
                <p>Evolution mensuelle du cout de maintenance par equipement,
                   pour reperer les derives et alimenter la decision de remplacement.</p>
            </field>
        </record>

        <!-- P5.2 : ecran analytique par site (complement du PDF rapport site).
             Pivot/graph sur gmao.request groupe par site. -->
        <record id="view_site_analysis_pivot" model="ir.ui.view">
            <field name="name">gmao.request.site.analysis.pivot</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <pivot string="Analyse par site">
                    <field name="site_id" type="row"/>
                    <field name="maintenance_type" type="col"/>
                    <field name="total_cost" type="measure"/>
                    <field name="downtime" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_site_analysis_graph" model="ir.ui.view">
            <field name="name">gmao.request.site.analysis.graph</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <graph string="Analyse par site" type="bar">
                    <field name="site_id"/>
                    <field name="total_cost" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="action_site_analysis" model="ir.actions.act_window">
            <field name="name">Analyse par site</field>
            <field name="res_model">gmao.request</field>
            <field name="view_mode">pivot,graph</field>
            <field name="view_id" ref="view_site_analysis_pivot"/>
            <field name="search_view_id" ref="view_maintenance_request_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Aucune intervention</p>
                <p>Coûts et temps d'arrêt par site. Pour le PDF complet par site,
                   utiliser « Rapport sites » (menu Action &#8594; Imprimer).</p>
            </field>
        </record>

        <!-- P6.4 : analyse des pannes (recurrence -> base de la prediction).
             Code panne x equipement x frequence/cout/downtime. -->
        <record id="view_failure_analysis_pivot" model="ir.ui.view">
            <field name="name">gmao.request.failure.analysis.pivot</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <pivot string="Analyse des pannes">
                    <field name="failure_code_id" type="row"/>
                    <field name="equipment_id" type="col"/>
                    <field name="total_cost" type="measure"/>
                    <field name="downtime" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_failure_analysis_graph" model="ir.ui.view">
            <field name="name">gmao.request.failure.analysis.graph</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <graph string="Analyse des pannes" type="bar">
                    <field name="failure_code_id"/>
                </graph>
            </field>
        </record>

        <record id="view_failure_analysis_tree" model="ir.ui.view">
            <field name="name">gmao.request.failure.analysis.tree</field>
            <field name="model">gmao.request</field>
            <field name="arch" type="xml">
                <tree string="Pannes" create="false"
                      decoration-warning="maintenance_type=='corrective'">
                    <field name="maintenance_type" invisible="1"/>
                    <field name="request_date"/>
                    <field name="failure_code_id"/>
                    <field name="failure_severity"/>
                    <field name="equipment_id"/>
                    <field name="site_id"/>
                    <field name="downtime" sum="Temps d'arrêt (h)"/>
                    <field name="total_cost" sum="Coût total"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="action_failure_analysis" model="ir.actions.act_window">
            <field name="name">Analyse des pannes</field>
            <field name="res_model">gmao.request</field>
            <field name="view_mode">pivot,graph,tree,form</field>
            <field name="domain">[('failure_code_id', '!=', False)]</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'sequence': 1, 'view_mode': 'pivot', 'view_id': ref('view_failure_analysis_pivot')}),
                (0, 0, {'sequence': 2, 'view_mode': 'graph', 'view_id': ref('view_failure_analysis_graph')}),
                (0, 0, {'sequence': 3, 'view_mode': 'tree', 'view_id': ref('view_failure_analysis_tree')})]"/>
            <field name="search_view_id" ref="view_maintenance_request_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Aucune panne enregistrée</p>
                <p>Récurrence des codes panne par équipement : repérez les pannes
                   répétitives pour cibler la maintenance préventive et anticiper.</p>
            </field>
        </record>

    </data>
</odoo>
