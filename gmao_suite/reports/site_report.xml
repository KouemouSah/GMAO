<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ================================================================ -->
        <!-- P5.2 : Rapport site (PDF complet, multi-doc).                     -->
        <!-- Agregats fournis par report.gmao_suite.report_site_document.     -->
        <!-- ================================================================ -->
        <record id="action_report_site" model="ir.actions.report">
            <field name="name">Rapport site</field>
            <field name="model">maintenance.site</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gmao_suite.report_site_document</field>
            <field name="report_file">gmao_suite.report_site</field>
            <field name="print_report_name">'Rapport site %s' % (object.code or object.name or '')</field>
            <field name="binding_model_id" ref="model_maintenance_site"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_site_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <t t-set="d" t-value="site_data[o.id]"/>
                        <div class="page">
                            <div class="row mb-3">
                                <div class="col-12">
                                    <h2 style="margin:0;">Rapport site</h2>
                                    <p class="text-muted mb-0">
                                        <span t-if="o.code">[<span t-field="o.code"/>] </span>
                                        <span t-field="o.name"/>
                                        <span t-if="o.city_id"> — <span t-field="o.city_id"/></span>
                                    </p>
                                    <p class="mb-0"><strong>Société : </strong><span t-field="o.company_id"/></p>
                                </div>
                            </div>

                            <!-- KPI site -->
                            <div class="row mb-2">
                                <div class="col-3"><strong>Équipements :</strong> <span t-esc="d['nb_equipment']"/></div>
                                <div class="col-3"><strong>Interventions :</strong> <span t-esc="d['nb_requests']"/></div>
                                <div class="col-3"><strong>% préventif :</strong> <span t-esc="d['pct_preventive']"/>%</div>
                                <div class="col-3"><strong>Arrêt cumulé :</strong> <span t-esc="d['downtime_total']"/> h</div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-3"><strong>MTBF moyen :</strong> <span t-esc="d['avg_mtbf']"/> h</div>
                                <div class="col-3"><strong>MTTR moyen :</strong> <span t-esc="d['avg_mttr']"/> h</div>
                                <div class="col-6"><strong>Coût total maintenance :</strong>
                                    <span t-esc="d['total_cost']"/> <span t-esc="d['currency'].symbol"/>
                                </div>
                            </div>

                            <!-- Detail par equipement -->
                            <h4 class="mt-3">Détail par équipement</h4>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Équipement</th>
                                        <th class="text-right">Interventions</th>
                                        <th class="text-right">Coût cumulé</th>
                                        <th class="text-right">Arrêt (h)</th>
                                        <th class="text-right">Ratio %</th>
                                        <th class="text-center">À remplacer</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="d['rows']" t-as="r">
                                        <td><span t-esc="r['equipment'].display_name"/></td>
                                        <td class="text-right"><span t-esc="r['nb']"/></td>
                                        <td class="text-right">
                                            <span t-esc="r['cost']"/> <span t-esc="d['currency'].symbol"/>
                                        </td>
                                        <td class="text-right"><span t-esc="r['downtime']"/></td>
                                        <td class="text-right"><span t-esc="'%.1f' % r['ratio']"/></td>
                                        <td class="text-center">
                                            <span t-if="r['replace']" class="badge badge-danger">Oui</span>
                                            <span t-if="not r['replace']">—</span>
                                        </td>
                                    </tr>
                                    <tr t-if="not d['rows']">
                                        <td colspan="6" class="text-center text-muted">Aucun équipement sur ce site.</td>
                                    </tr>
                                </tbody>
                            </table>

                            <p class="text-muted mt-4" style="font-size:11px;">
                                Aide à la décision : comparer les équipements à fort coût cumulé /
                                temps d'arrêt élevé pour prioriser remplacements et maintenance préventive.
                            </p>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
