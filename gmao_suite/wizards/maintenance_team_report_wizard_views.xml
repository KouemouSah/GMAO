<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_maintenance_team_report_wizard_form" model="ir.ui.view">
        <field name="name">maintenance.team.report.wizard.form</field>
        <field name="model">maintenance.team.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimer Rapport">
                <group>
                    <field name="team_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button string="Annuler" class="btn-default" special="cancel"/>
                    <button string="Imprimer" type="object" name="action_print_report" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
